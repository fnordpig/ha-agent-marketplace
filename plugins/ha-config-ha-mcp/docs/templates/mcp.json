{
  "mcpServers": {
    "home-assistant-config-uvx": {
      "command": "uvx",
      "args": ["ha-mcp@latest"],
      "env": {
        "HOMEASSISTANT_URL": "${HOMEASSISTANT_URL}",
        "HOMEASSISTANT_TOKEN": "${HOMEASSISTANT_TOKEN}"
      }
    },
    "home-assistant-config-http": {
      "type": "http",
      "url": "${HA_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${HA_MCP_TOKEN}"
      }
    }
  }
}
