{
  "description": "Conservative Home Assistant warning hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use_policy.py\" && uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use_policy.py\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"${CLAUDE_PLUGIN_ROOT}/hooks/post_turn_summary.py\" && uv run python \"${CLAUDE_PLUGIN_ROOT}/hooks/post_turn_summary.py\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
